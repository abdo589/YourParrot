# Public URL of the site (used for sitemap, robots and metadata)
NEXT_PUBLIC_SITE_URL=https://yourparrot.sa

# Admin dashboard (/admin). Leave empty to disable it.
# At least 12 characters.
ADMIN_PASSWORD=
# Random secret, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Where orders and messages are stored (JSON Lines). Defaults to ./data
DATA_DIR=

# Online payments (mada, Apple Pay, Visa/Mastercard, STC Pay) via Moyasar.
# Leave empty to offer cash on delivery only. Requires NEXT_PUBLIC_SITE_URL.
# Use sk_test_... keys while testing, sk_live_... in production. Never commit real keys.
MOYASAR_SECRET_KEY=
# Same value as the "secret token" set for the webhook in the Moyasar dashboard
MOYASAR_WEBHOOK_SECRET=

# Shown in the footer (required by the Saudi e-commerce law)
NEXT_PUBLIC_CR_NUMBER=
NEXT_PUBLIC_VAT_NUMBER=
